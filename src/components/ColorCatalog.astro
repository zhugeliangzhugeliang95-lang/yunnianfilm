---
import ColorShortlist from './ColorShortlist.astro';
import {content} from '../data/i18n';
import {products,families,finishLabel,nameCheckLabel} from '../../public/automotive-studio/viewer/catalog/product-catalog.js';
const {lang,path}=content(Astro.url);const z=lang==='zh';const base='/automotive-studio/viewer/';
const quote=(p)=>path('/contact/?'+new URLSearchParams({product:'TPU Color PPF · Color Catalog',colors:p.id,intent:'Wholesale quote'}));
---
<section class="container existing-colors" data-existing-colors data-lang={lang}>
 <div class="color-catalog-tools"><label class="color-search-label" for="color-product-search"><span>{z?'搜索颜色、编号或英文名称':'Search Color, Reference Or English Name'}</span><input id="color-product-search" type="search" placeholder={z?'例如：绿、Green、YN-0001':'e.g. Green, Jade, YN-0001'} autocomplete="off" maxlength="100"/></label><label for="color-family"><span>{z?'按色系选择':'Color Family'}</span><select id="color-family"><option value="">{z?'全部色系':'All Colors'}</option>{families.map(f=><option value={f[0]}>{f[z?2:1]}</option>)}</select></label><button type="button" id="color-reset">{z?'清除筛选':'Clear Filters'}</button></div>
 <p class="color-catalog-summary"><span id="color-result-count" role="status" aria-live="polite">{products.length} {z?'款现有产品颜色':'Existing Product Colors'}</span><span>{z?'每张图片对应一种产品，质感以该款色卡为准。':'Each Card Is One Product. Its Finish Is Fixed To That Card.'}</span></p>
 <ColorShortlist lang={lang}/>
 <div class="color-product-grid">{products.map(p=><article class="color-product-card" data-color-product={p.id}><button type="button" class="color-card-photo" data-view-card={p.id} aria-label={(z?'查看色卡：':'View Color Card: ')+p.reference+' '+p.nameEn}><img src={base+p.thumbnail} alt={p.nameEn} width="424" height="240" loading="lazy" decoding="async"/></button><div class="color-card-meta"><span>{p.reference}</span><span>{finishLabel(p,lang)}</span></div><h2>{p.nameEn}</h2>{z&&<p class="color-name-original">{p.name}</p>}{p.nameCheck&&<p class="color-name-check">{nameCheckLabel(lang)}</p>}{!p.canPreview&&<p class="color-name-check">{z?'此款原图纹理不清晰，请查看原图并确认实物。':'The Texture Is Not Clear In This Photo. Please Check The Original Card And Physical Sample.'}</p>}<div class="color-card-actions">{p.canPreview&&<a class="color-car-link" href={base+'?'+new URLSearchParams({lang,card:p.id})} data-preview-product={p.id}>{z?'放到车上看':'View On Car'} ↗</a>}<button type="button" data-view-card={p.id}>{z?'查看原图':'View Card'} ↗</button><button type="button" data-save-color={p.id} aria-pressed="false">{z?'+ 加入清单':'+ Save color'}</button><a href={quote(p)}>{z?'咨询购买':'Enquire To Order'} ↗</a></div></article>)}</div>
 <p id="color-no-results" hidden>{z?'没有匹配的产品颜色，请换个关键词或清除筛选。':'No Matching Colors. Try Another Search Or Clear The Filters.'}</p>
 <button type="button" id="color-show-more" class="button button-dark" hidden>{z?'查看更多颜色':'View More Colors'}</button>
 <p class="color-reference-note">{z?'YN 编号为网站目录编号，询价时请同时提供编号与英文名称。屏幕显示可能有色差，请以实物色卡确认。':'YN References Identify Website Catalog Entries. Include The Reference And English Name In Your Inquiry. Confirm Color With A Physical Swatch.'}</p>
 <dialog id="color-vehicle-dialog" aria-labelledby="color-vehicle-title"><div class="color-vehicle-heading"><div><span>{z?'所选产品 · 车身预览':'Selected Product · Vehicle Preview'}</span><h2 id="color-vehicle-title"></h2></div><button type="button" id="color-vehicle-close" aria-label={z?'关闭车身预览':'Close Vehicle Preview'}>×</button></div><iframe id="color-vehicle-frame" title={z?'所选产品的交互车身预览':'Interactive Vehicle Preview Of Selected Product'} allow="fullscreen" allowfullscreen></iframe><div class="color-vehicle-footer"><span>{z?'拖动旋转，滚轮缩放；右侧原图可放大对照。':'Drag To Rotate, Scroll To Zoom. Enlarge The Original Card To Compare.'}</span><a id="color-vehicle-full" href={base} target="_blank" rel="noopener">{z?'打开完整预览':'Open Full Preview'} ↗</a></div></dialog>
 <dialog id="color-card-dialog" aria-labelledby="color-card-title"><div class="color-dialog-heading"><div><p id="color-card-reference"></p><h2 id="color-card-title"></h2></div><button type="button" id="color-card-close" aria-label={z?'关闭色卡':'Close Color Card'}>×</button></div><img id="color-card-image" alt="" width="1272" height="720"/><p id="color-card-name-check" class="color-name-check" hidden>{nameCheckLabel(lang)}</p><div class="color-dialog-actions"><span id="color-card-finish"></span><button type="button" id="color-card-save" data-save-color="" aria-pressed="false">{z?'+ 加入清单':'+ Save color'}</button><a id="color-card-order" class="button button-dark" href={path('/contact/')}>{z?'咨询购买这款颜色':'Enquire About This Color'} ↗</a><a id="color-card-model" data-preview-product="" class="text-link" href={base+'?lang='+lang}>{z?'查看车身示意':'View On Vehicle'} ↗</a></div></dialog>
</section>
<script>import '../scripts/color-catalog';</script>
