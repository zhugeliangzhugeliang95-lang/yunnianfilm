---
import {content} from '../data/i18n';
const {lang,company}=content(Astro.url);const z=lang==='zh';
const networks=[
 {name:'TikTok',url:'https://www.tiktok.com/@yunnianfilm',path:'M16.7 2c.3 2.4 1.6 3.8 4 4v4a9.2 9.2 0 0 1-4-1.2v7.3a6.7 6.7 0 1 1-5.8-6.6v4a2.7 2.7 0 1 0 1.8 2.6V2z'},
 {name:'Facebook',url:'https://www.facebook.com/profile.php?id=61565028900488',path:'M14 22v-9h3l.5-3.5H14V7.3c0-1 .3-1.8 1.8-1.8H18V2.4A27 27 0 0 0 15 2c-3 0-5 1.8-5 5v2.5H7V13h3v9z'},
 {name:'Instagram',url:'https://www.instagram.com/enli8195/',path:''},
 {name:'YouTube',url:'https://www.youtube.com/channel/UCvWjT6Dk6Z76mlAuceUgrHw',path:''},
 {name:'WhatsApp',url:'https://wa.me/'+company.whatsapp,path:''},
];
---
<aside class="social-dock" aria-label={z?'关注云辇与在线联系':'Follow YUNNIAN And Contact Us'}>
 <div class="social-dock-links" id="social-dock-links">
  {networks.map(n=><a class="social-link" href={n.url} target="_blank" rel="noopener noreferrer" aria-label={n.name+(z?'（新窗口打开）':' (Opens In A New Tab)')}>
   <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    {n.path&&<path fill="currentColor" d={n.path}/>}
    {n.name==='Instagram'&&<g fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.7" r=".8" fill="currentColor" stroke="none"/></g>}
    {n.name==='YouTube'&&<><rect x="2" y="5" width="20" height="14" rx="4" fill="currentColor"/><path d="m10 9 6 3-6 3z" fill="var(--social-surface)"/></>}
    {n.name==='WhatsApp'&&<g fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 11.7a8.5 8.5 0 0 1-12.7 7.4L3 20.5l1.4-4.6A8.5 8.5 0 1 1 20.5 11.7Z"/><path d="m8 7.5 1.8-.2 1 2.5-1.1 1.1c.8 1.6 1.8 2.6 3.4 3.4l1.1-1.1 2.5 1-.2 1.8c-.1.7-1.3 1.2-2 1-4.5-1-6.9-3.4-7.9-7.9-.2-.7.3-1.5 1.4-1.6Z"/></g>}
   </svg><span class="social-tooltip">{n.name}</span>
  </a>)}
 </div>
 <button class="social-dock-toggle" type="button" aria-controls="social-dock-links" aria-expanded="false" aria-label={z?'展开社交链接':'Open Social Links'} data-open-label={z?'展开社交链接':'Open Social Links'} data-close-label={z?'收起社交链接':'Close Social Links'}><svg class="social-toggle-open" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="6" cy="12" r="3"/><circle cx="18" cy="5" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.5 10.5 7-4m-7 7 7 4"/></svg><svg class="social-toggle-close" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
</aside>
<script>
 const dock=document.querySelector<HTMLElement>('.social-dock');
 const trigger=dock?.querySelector<HTMLButtonElement>('.social-dock-toggle');
 const links=dock?.querySelector<HTMLElement>('.social-dock-links');
 const mobile=matchMedia('(max-width: 900px)');
 function setDock(open:boolean){if(!dock||!trigger||!links)return;dock.classList.toggle('is-open',open);trigger.setAttribute('aria-expanded',String(open));trigger.setAttribute('aria-label',(open?trigger.dataset.closeLabel:trigger.dataset.openLabel)!);links.inert=mobile.matches&&!open;}
 trigger?.addEventListener('click',()=>setDock(trigger.getAttribute('aria-expanded')!=='true'));
 document.addEventListener('click',e=>{if(mobile.matches&&dock&&!dock.contains(e.target as Node))setDock(false);});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&trigger?.getAttribute('aria-expanded')==='true'){setDock(false);trigger.focus();}});
 dock?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{if(mobile.matches)setDock(false);}));
 mobile.addEventListener('change',()=>setDock(false));setDock(false);
</script>
