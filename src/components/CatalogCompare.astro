---
import {content} from '../data/i18n';
const {lang,path}=content(Astro.url);const L=(en:string,zh:string)=>lang==='zh'?zh:en;
---
<div class="comparison-tray" id="comparison-tray" hidden><div class="comparison-tray-inner"><div><span class="eyebrow">{L('YOUR SHORTLIST','产品意向清单')}</span><p id="selection-summary" aria-live="polite"></p></div><div class="tray-actions"><button id="clear-comparison" type="button">{L('Clear','清空')}</button><button id="open-comparison" class="button button-accent" type="button" disabled>{L('Compare films','并排对比')} ↗</button></div></div></div>
<dialog id="comparison-dialog" aria-labelledby="comparison-title"><header class="comparison-heading"><div><span class="eyebrow">YUNNIAN / FILM SELECTOR</span><h2 id="comparison-title">{L('Look closer. Choose better.','放在一起，更好选择。')}</h2></div><button id="close-comparison" class="dialog-close" type="button" aria-label={L('Close comparison','关闭对比')}>×</button></header><p class="comparison-note">{L('Compare listed specifications, then request samples. These are different film applications, not a performance ranking.','对照已列规格，再通过样品确认。不同膜材适用部位不同，参数对比不代表性能排名。')}</p><p class="comparison-swipe-hint">{L('Swipe sideways to compare all selected films →','左右滑动，查看全部已选产品 →')}</p><div class="comparison-scroll" tabindex="0" aria-label={L('Film comparison table; scroll horizontally on small screens','产品对比表，小屏幕可横向滚动')}><table id="comparison-table"></table></div><footer class="comparison-footer"><p>{L('Ask for the current data sheet and written terms for each selected film.','可向我们索取所选产品的最新技术资料与书面条款。')}</p><a id="compare-samples" class="button button-dark" href={path('/contact/?intent=Sample%20request')}>{L('Discuss these samples','咨询这组样品')} ↗</a></footer></dialog>
