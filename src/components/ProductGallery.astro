---
import SeriesPanel from './SeriesPanel.astro';
import galleryData from '../data/gallery.json';
import {content} from '../data/i18n';
const {lang,t}=content(Astro.url);const {product:p}=Astro.props;
const L=(en:string,zh:string)=>lang==='zh'?zh:en;
const gallery=(galleryData as Record<string,{variant:string;image:string}[]>)[p.slug]||[];
const initial=gallery.find(x=>x.variant===p.options[0]);
const first=initial?.image||p.image;const caption=initial?t(initial.variant):L(p.categoryArtwork?'Category Illustration':'Product Overview',p.categoryArtwork?'类别示意图':'产品概览');
---
{!p.image ? <div class="product-gallery"><SeriesPanel product={p}/><p class="gallery-note">{L('Series profile. Request current product photos and physical samples for your chosen color.','系列资料展示。可咨询所选颜色的产品实拍与实物样品。')}</p></div> : <><div class="product-gallery"><div class="detail-image"><img id="gallery-image" src={'/images/'+first} data-default-src={'/images/'+p.image} data-default-alt={p.name} alt={p.name+' · '+caption} width="1400" height="1050" fetchpriority="high"/><button class="gallery-zoom" type="button" id="gallery-enlarge">{L('View larger','查看大图')} ↗</button></div><div class="gallery-caption"><strong id="gallery-caption" data-default={L(p.categoryArtwork?'Category Illustration':'Product Overview',p.categoryArtwork?'类别示意图':'产品概览')}>{caption}</strong><span>{L(p.categoryArtwork?'CATEGORY IMAGERY':'PRODUCT IMAGERY',p.categoryArtwork?'类别素材展示':'实物产品资料')}</span></div>{gallery.length>0 && <div class="gallery-thumbs" role="group" aria-label={L('Choose a color image','选择颜色图片')}>{gallery.map((g,i)=><button type="button" data-gallery-image={'/images/'+g.image} data-gallery-variant={g.variant} data-gallery-caption={t(g.variant)} aria-pressed={i===0?'true':'false'} aria-label={L('Select ','选择')+t(g.variant)}><img src={'/images/'+g.image} loading="lazy" width="100" height="70" alt={t(g.variant)}/></button>)}</div>}<p class="gallery-note">{L('Screen color and lighting can vary. Confirm the finish with a physical sample.','屏幕与拍摄光线会影响色彩呈现，实际质感请以实物样品确认。')}</p></div>
<dialog id="gallery-lightbox" aria-labelledby="lightbox-caption"><div class="lightbox-heading"><strong id="lightbox-caption">{caption}</strong><button id="gallery-close" class="dialog-close" type="button" aria-label={L('Close image','关闭图片')}>×</button></div><img id="lightbox-image" src={'/images/'+first} alt={p.name+' · '+caption} width="1400" height="1050" loading="lazy"/></dialog></>}
<script>
 function setupGallery(){
 const main=document.querySelector<HTMLImageElement>('#gallery-image')!;
 if(!main)return;
 const caption=document.querySelector<HTMLElement>('#gallery-caption')!;
 const picker=document.querySelector<HTMLSelectElement>('#variant');
 let chosen:HTMLButtonElement|undefined;
 const thumbs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-image]'));
 function updateImage(){const active=picker?thumbs.find(b=>b.dataset.galleryVariant===picker.value):chosen;main.src=active?.dataset.galleryImage||main.dataset.defaultSrc!;caption.textContent=active?.dataset.galleryCaption||caption.dataset.default!;main.alt=main.dataset.defaultAlt+' · '+caption.textContent;thumbs.forEach(b=>b.setAttribute('aria-pressed',String(b===active)));}
 thumbs.forEach(b=>b.addEventListener('click',()=>{chosen=b;if(picker){picker.value=b.dataset.galleryVariant!;picker.dispatchEvent(new Event('change',{bubbles:true}));}else{updateImage();}}));picker?.addEventListener('change',updateImage);
 // The detail script applies the requested variant after all bundled scripts initialize.
 queueMicrotask(updateImage);
 const lightbox=document.querySelector<HTMLDialogElement>('#gallery-lightbox')!;
 document.querySelector('#gallery-enlarge')?.addEventListener('click',()=>{const image=document.querySelector<HTMLImageElement>('#lightbox-image')!;image.src=main.src;image.alt=main.alt;document.querySelector('#lightbox-caption')!.textContent=caption.textContent;lightbox.showModal();document.body.classList.add('comparison-open');});
 document.querySelector('#gallery-close')?.addEventListener('click',()=>lightbox.close());lightbox.addEventListener('close',()=>{document.body.classList.remove('comparison-open');document.querySelector<HTMLButtonElement>('#gallery-enlarge')?.focus();});
 }
 setupGallery();
</script>
