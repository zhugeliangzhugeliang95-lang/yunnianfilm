---
import {content} from '../data/i18n';import {blogPosts} from '../data/blog';const {lang,path}=content(Astro.url);const z=lang==='zh';const {all=false}=Astro.props;const featured=['tpu-color-ppf-and-pet-wraps','beyond-reflection-the-science-of-yunnian-silver-plated-radiative-cooling-sky-film','coating-tech-revolution-embedded-coating-reshapes-ppf-lifespan'];
const posts=all?blogPosts:featured.map(slug=>blogPosts.find(post=>post.slug===slug)).filter(Boolean);
---
<section class="container section journal-section" id="journal">{!all&&<div class="section-heading"><div><span class="eyebrow">03 / {z?'云辇博客':'THE YUNNIAN JOURNAL'}</span><h2>{z?'选材有据，灵感有源。':'Materials. Knowledge. Inspiration.'}</h2></div><a class="text-link" href={path('/blog/')}>{z?'阅读全部文章':'Read all stories'} ↗</a></div>}<div class:list={['journal-grid',all&&'journal-grid-all']}>{posts.map(p=><article><a class="journal-image" href={path('/blog/'+p.slug+'/')}><img src={'/images/'+p.image} width="800" height="520" loading="lazy" alt={p.title[lang]}/><span aria-hidden="true">↗</span></a><div class="journal-meta"><span>{p.category[lang]}</span><span>{p.readMinutes} {z?'分钟阅读':'MIN READ'}</span></div><h3><a href={path('/blog/'+p.slug+'/')}>{p.title[lang]}</a></h3><p>{p.excerpt[lang]}</p></article>)}</div></section>
