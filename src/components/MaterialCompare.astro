---
import {content} from '../data/i18n';import {editorial} from '../data/editorial';const {lang,path}=content(Astro.url);const {L}=editorial(lang);
const items=[{name:'Lubrizol® SM301',title:L('Clear PPF','透明车衣'),thickness:'6.5 / 7.5 / 8.5 / 9.5 mil',coat:L('Hydrophobic','疏水涂层'),slug:'lubrizol-sm301-ppf',image:'clear-ppf-application.webp'},{name:'BASF Elastollan®',title:L('Clear PPF','透明车衣'),thickness:'6.5 / 7.5 / 8.5 mil',coat:L('Hydrophilic / hydrophobic','亲水 / 疏水涂层'),slug:'basf-elastollan-ppf',image:'basf-ppf.webp'},{name:'Covestro™ TPU',title:L('Clear PPF','透明车衣'),thickness:'7.5 / 8.5 / 9.5 mil',coat:L('Confirm selected variant','按具体规格确认'),slug:'covestro-ppf',image:'covestro-ppf.webp'}];
---
<section class="container section compact-compare"><div class="section-heading"><div><span class="eyebrow">02 / {L('COMPARE YOUR STARTING POINTS','把材料放在一起看')}</span><h2>{L('Three substrates.','三种基材，')}<br />{L('A clearer choice.','选择更清楚。')}</h2></div><p class="heading-description">{L('Compare the current listed ranges. Confirm the exact product data and coating with your quotation.','对比现有资料中的系列选项，具体参数与涂层以所选型号及报价确认为准。')}</p></div><div class="compact-materials">{items.map((p,i)=><article><div class="compare-title"><img src={'/images/'+p.image} alt={p.name+' '+p.title} width="150" height="150" loading="lazy"/><div><span class="eyebrow">0{i+1} / {p.title}</span><h3>{p.name}</h3></div></div><dl><div><dt>{L('Listed thickness','可选厚度')}</dt><dd>{p.thickness}</dd></div><div><dt>{L('Coating','涂层选择')}</dt><dd>{p.coat}</dd></div><div><dt>{L('Next step','评估建议')}</dt><dd>{L('Request product data & samples','索取产品资料与样品')}</dd></div></dl><a class="text-link" href={path('/products/'+p.slug+'/')}>{L('See the specifications','查看具体规格')} <span aria-hidden="true">↗</span></a></article>)}</div></section>
