---
import {categories,categoryUrl} from '../data/categories';
import {content} from '../data/i18n';import {editorial} from '../data/editorial';import Product from './Product.astro';
const {lang,t,path,products}=content(Astro.url);const {L}=editorial(lang);
const featured=['lubrizol-sm301-ppf','classic-color-ppf','liquid-metal-color-ppf','magic-pearl-color-ppf','carbon-fiber-ppf','chameleon-aurora-window-film'].map(slug=>products.find(p=>p.slug===slug)!);
---
<div class="range-navigation container" aria-label={L('Browse by film type','按膜材类别浏览')}>{categories.map(c=><a href={path(categoryUrl(c.key))}>{c.image?<img src={'/images/'+c.image} width="120" height="120" alt=""/>:<span class="range-mark" aria-hidden="true">{c.mark}</span>}<div><span class="eyebrow">{c.code} / {products.filter(p=>p.category===c.key).length} {L('SERIES','个系列')}</span><strong>{c[lang]}</strong><small>{c.summary[lang==='zh'?1:0]}</small></div><span aria-hidden="true">↗</span></a>)}</div>
<section class="container section featured-collection" id="collections"><div class="section-heading"><div><span class="eyebrow">01 / {L('PRODUCTS IN FOCUS','从具体产品开始')}</span><h2>{L('The right film.','选对材料，')}<br class="desktop-break"/>{L('For your next project.','找到合适的产品。')}</h2></div><div class="featured-intro"><p>{L('Explore substrates, finishes and roll formats. Build a shortlist, then evaluate physical samples.','从基材、质感到卷材规格，先建立产品意向，再通过实物样品评估。')}</p><a class="text-link" href={path('/products/')}>{L(`Explore all ${products.length} series`,`查看全部 ${products.length} 个系列`)} <span aria-hidden="true">↗</span></a></div></div><div class="product-grid featured-grid">{featured.map((p,i)=><Product product={p} index={i}/>)}</div><div class="collection-assist"><span>{L('Need a starting point?','还不确定从哪里开始？')}</span><a href={path('/film-guide/')}>{L('Choose by application','按应用快速选型')} ↗</a><a href={path('/color-studio/')}>{L('Explore the color studio','进入色彩工作室')} ↗</a><a href={path('/products/?category=Headlight%20films')}>{L('Explore headlight films','了解灯膜系列')} ↗</a></div></section>
