---
import details from '../data/source-product-details.json';
import originals from '../data/journal-originals.json';
import {blogPosts} from '../data/blog';
import {content} from '../data/i18n';
import SourceText from './SourceText.astro';
import {managedBySlug,modelWord} from '../data/managed-products';
import {modelTablesHTML} from '../../public/catalog-ui/model-tables.js';
import {siteLanguage} from '../locales/languages';
import '../styles/source-library.css';
const {product}=Astro.props;
const {lang,path,t,products}=content(Astro.url);
const z=lang==='zh';
const records=details[product.slug as keyof typeof details] ?? [];
const locale=siteLanguage(Astro.url.pathname).id;
const verified=managedBySlug.get(product.slug)!;
const photos=verified.gallery.filter(photo=>records.some(r=>r.images.some(im=>im.src===photo.src))).map(photo=>({
 src:photo.src,caption:photo.labels[locale]||photo.caption,
 variants:verified.variants.filter(v=>v.src===photo.src&&v.kind==='variant').map(v=>v.labels[locale]||v.value),
}));
const reports=Array.from(new Map(records.flatMap(r=>r.documents).map(doc=>[doc.path,doc])).values());
const articles=blogPosts.filter(post=>originals[post.slug as keyof typeof originals]?.related===product.slug);
const children=product.slug==='titanium-carbide-window-film'||product.slug==='titanium-nitride-window-film' ? products.filter(p=>p.slug!==product.slug && (details[p.slug as keyof typeof details]?.some(r=>r.title.toLowerCase().includes(product.slug.includes('carbide')?'titanium carbide':'titanium nitride')))) : [];
---
<section class="container source-section" data-product-library hidden={!records.length} aria-labelledby="model-library">
 <div class="library-title"><div><span class="eyebrow">{z?'产品资料':'PRODUCT DOCUMENTATION'}</span><h2 id="model-library">{z?'型号与技术资料':'Models & technical data'}</h2></div></div>
 <div data-model-tables set:html={modelTablesHTML(verified.tables,locale,(cell:string)=>modelWord(cell,locale))}/>
 <p class="library-note" data-model-note hidden={!(product.category==='Window film' && verified.tables.length)}>{z?'数据按原型号表展示。带 % 的数值为原表百分数，纯小数保留原值。比较前请核对测试波段、玻璃组合与厚度。':'Figures retain the published notation, including literal decimals and percentages. Check the wavelength, glazing and thickness before comparing models.'}</p>
 <div data-product-sources>
 {photos.length>0&&<details class="library-fold"><summary>{z?'产品图册':'Product gallery'} <small>{photos.length}</small></summary><div class="reference-gallery">{photos.map((im,i)=><a href={im.src} target="_blank" rel="noopener" aria-label={(z?'查看大图':'Open image')+' '+(i+1)}><img src={im.src} width="420" height="340" loading="lazy" decoding="async" alt={im.caption}/>{im.variants.length>0&&<span>{im.variants.map(t).join(' / ')}</span>}</a>)}</div></details>}
 {reports.length>0&&<details class="library-fold"><summary>{z?'送检样品报告':'Submitted sample reports'} <small>PDF</small></summary><p>{z?'下列报告对应文件内注明的送检样品及测试范围。采购时可核对样品名称、报告编号及出货型号。':'Each report identifies the submitted sample and test scope. Match the sample, report number and ordered model when reviewing it.'}</p><ul class="document-links">{reports.map(doc=><li><a href={doc.path} target="_blank" rel="noopener">{doc.label.replace('YUNNIAN-SGS-','SGS · ').replace(/-/g,' ')} ↗</a></li>)}</ul></details>}
 {Array.from(new Map(records.map(r=>[r.body,r])).values()).map(r=><details class="library-fold"><summary>{z?'查看原版英文产品说明':'Original product description'}{records.length>1&&<small>{r.title}</small>}</summary><p class="library-note">{z?'以下保留该型号发布时的产品资料。供货、质保与测试适用范围以本次报价及书面文件为准。':'This is the original model literature. Confirm supply, warranty and test applicability in the current written quotation.'}</p><div lang="en" dir="ltr" translate="no"><SourceText html={r.body}/></div></details>)}
 <div class="service-links">{records.map(r=><a href={'https://www.ynfilm.com/products/'+r.handle}>{z?'原商城商品页':'Original store listing'}{records.length>1?' · '+r.title:''} ↗</a>)}</div>
 {articles.length>0&&<div class="model-guides">{articles.map(a=><a class="text-link" href={path('/blog/'+a.slug+'/')}>{a.title[lang]} ↗</a>)}</div>}
</div></section>
{children.length>0&&<section class="container source-section" data-product-sources><div class="library-title"><h2>{z?'该材料下的窗膜系列':'Series in this material'}</h2></div><div class="model-guides">{children.map(c=><a href={path('/products/'+c.slug+'/')}>{c.name} ↗</a>)}</div></section>}
