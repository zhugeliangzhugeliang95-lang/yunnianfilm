---
import {content} from '../data/i18n';import {editorial} from '../data/editorial';const {lang,path}=content(Astro.url);const {L}=editorial(lang);
const steps=[[L('Your product mix','您的产品组合'),L('Substrate, thickness, color and roll format. Start with what your customers need.','基材、厚度、颜色与卷材尺寸，从客户需求出发确定产品方向。')],[L('Your brand details','您的品牌细节'),L('Discuss labels, boxes and artwork requirements. Confirm customization scope before ordering.','讨论标签、外箱与设计文件，在订货前确认具体定制范围。')],[L('Your supply plan','您的采购计划'),L('Agree the quantity, sample review, destination and schedule in a written quotation.','在书面报价中明确数量、样品评估、目的地及时间安排。')]];
---
<section class="partner-workshop container section"><div class="workshop-photo"><img src="/images/install.webp" width="800" height="533" loading="lazy" alt={L('Film manufacturing equipment shown in YUNNIAN company materials','云辇公司资料中展示的膜材生产设备')}/><span>{L('YUNNIAN / COMPANY IMAGERY','YUNNIAN / 公司资料')}</span></div><div class="workshop-copy"><span class="eyebrow">05 / OEM & ODM</span><h2>{L('From the film.','从产品选型，')}<br />{L('To your brand.','到您的品牌。')}</h2><ol>{steps.map(([title,desc],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p>{desc}</p></div></li>)}</ol><div class="workshop-actions"><a class="button button-dark" href={path('/contact/?intent=OEM%20cooperation')}>{L('Discuss an OEM project','沟通 OEM 项目')} ↗</a><a class="text-link" href={'/downloads/oem-brief-'+lang+'.txt'} download>{L('Download project brief','下载需求表')} ↓</a></div></div></section>
