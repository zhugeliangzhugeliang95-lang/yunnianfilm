---
import {content} from '../data/i18n';
const {lang,path}=content(Astro.url);const z=lang==='zh';const L=(en:string,zh:string)=>z?zh:en;
const {initialMode='tpu-color',embedded=false,standalone=false}=Astro.props;const Heading=standalone?'h1':'h2';
const modes=[['tpu-color','TPU COLOR','TPU 彩色车衣'],['ppf','TPU PROTECTION','TPU 漆面保护膜'],['window','PET WINDOW','PET 防晒隔热窗膜'],['pet-color','PET COLOR','PET 改色膜']];
const layers=[
 [L('Surface protection cap','表面保护膜'),L('Optional removable handling layer. Follow the selected product’s removal instructions.','部分型号配有的临时保护层。移除时机以对应产品施工说明为准。')],
 [L('Functional topcoat','功能涂层'),L('The outer functional surface. Coating properties and care depend on the selected product.','外侧功能表面。涂层特性与养护方式因具体型号而异。')],
 [L('TPU substrate','TPU 基膜'),L('The body of the paint-protection film. Compare substrate grade and the stated thickness definition.','车衣的主体材料。选型时比较基材型号及厚度的具体口径。')],
 [L('Adhesive','胶粘层'),L('Bonds the film to the prepared paint surface. Confirm compatibility and installation guidance.','与准备好的漆面贴合。需确认表面适配和施工说明。')],
 [L('Release liner','离型膜'),L('Protects the adhesive before application. Removed during installation, rather than left on the vehicle.','贴合前保护胶面，施工时移除，不保留在车辆表面。')],
];

---
<section class:list={['film-lab-section',embedded&&'lab-embedded']} id="film-lab" data-film-lab data-initial-mode={initialMode} data-lang={lang} data-contact-path={path('/contact/')}>
 <div class="container lab-heading"><div><span class="eyebrow">YUNNIAN / MATERIAL LAB</span><Heading>{L('See the material.','看见材料，')}<br/>{L('Explore the possibilities.','探索更多可能。')}</Heading></div><p>{L('Preview existing product colors. Look inside the layers.','查看现有产品颜色，了解材料分层。')}</p></div>
 <div class="container"><div class="lab-tabs" role="tablist" aria-label={L('Choose a material experience','选择材料体验')}>{modes.map(([id,en,zh],i)=><button id={'lab-tab-'+id} type="button" role="tab" data-lab-mode={id} aria-selected={id===initialMode?'true':'false'} aria-controls="lab-stage-panel" tabindex={id===initialMode?0:-1}><span>0{i+1}</span>{z?zh:en}</button>)}</div>
 <div id="lab-stage-panel" role="tabpanel" aria-labelledby={'lab-tab-'+initialMode}>
  <div class="lab-color-studio" data-color-studio hidden={initialMode!=='tpu-color'}>
   <div class="lab-studio-toolbar"><a href={path('/color-studio/')}>{L('Browse All Product Colors','浏览全部现有颜色')} ↗</a><a data-open-studio href={'/automotive-studio/viewer/?lang='+lang} target="_blank" rel="noopener">{L('Open full studio','打开完整工作室')} ↗</a></div>
   <iframe data-studio-frame title={L('YUNNIAN Aventador interactive color studio','云辇 Aventador 产品颜色预览')} loading="lazy" allow="fullscreen" allowfullscreen></iframe>
  </div>
  <div class="lab-pet-product" data-pet-product hidden={initialMode!=='pet-color'}><img src="/images/pet-color-wrap-category.webp" alt={L('PET Color Wraps','PET 改色膜')} width="750" height="750" loading="lazy"/><div><span class="eyebrow">PET / PRODUCT COLLECTION</span><h3>{L('PET Color Wraps','PET 改色膜')}</h3><p>{L('Choose From The Available PET Product Range. Confirm Your Selected Product With Its Physical Color Card.','从现有 PET 改色系列中选择，具体产品颜色以对应实物色卡为准。')}</p><a class="button button-dark" href={path('/products/pet-tech-color-wrap/')}>{L('View PET Products','查看 PET 产品')} ↗</a></div></div><div class="lab-workspace" data-material-workspace hidden={['tpu-color','pet-color'].includes(initialMode)}>
  <div class="lab-viewport"><div class="lab-canvas" data-lab-canvas role="img" aria-label={L('Interactive 3D material model; use the adjacent controls or drag to rotate','可交互的三维材料模型；可拖动旋转或使用旁边控件')} tabindex="0"><div class="lab-loading"><span class="lab-loading-mark">Y</span><p data-lab-status>{L('Preparing the 3D studio…','正在准备 3D 展台…')}</p><button type="button" data-lab-retry hidden>{L('Try 3D again','重新加载 3D')}</button></div></div>
   <div class="lab-canvas-label"><span data-lab-scene-label>TPU / COLOR</span><span>{L('3D CONCEPT MODEL','3D 概念模型')}</span></div>
   <div class="lab-view-controls" role="group" aria-label={L('Model view controls','模型视角控制')}><button type="button" data-lab-view="front">{L('Front','前视')}</button><button type="button" data-lab-view="side">{L('Side','侧视')}</button><button type="button" data-lab-view="reset">{L('Reset view','重置视角')}</button><button type="button" data-lab-rotate aria-pressed="false">{L('Auto rotate','自动旋转')}</button></div>
   <span class="lab-drag-hint">{L('DRAG TO ROTATE · PINCH TO ZOOM','拖动旋转 · 双指缩放')}</span>
  </div>
  <div class="lab-controls">
   <div data-lab-controls="ppf" hidden><span class="eyebrow">{L('INSIDE THE FILM','走进膜层')}</span><h3>{L('Every layer has a role.','每一层，各司其职。')}</h3><label class="lab-range-label" for="lab-explode"><span>{L('Explode the layers','展开膜层')}</span><output data-explode-output>65%</output></label><input id="lab-explode" type="range" min="0" max="100" value="65"/><div class="lab-layer-list" role="group" aria-label={L('Select a layer','选择膜层')}>{layers.map(([title,body],i)=><button type="button" data-lab-layer={i} aria-pressed={i===2?'true':'false'}><span>0{i+1}</span>{title}<span aria-hidden="true">↗</span></button>)}</div><div class="lab-layer-notes" aria-live="polite">{layers.map(([title,body],i)=><p data-lab-layer-note={i} hidden={i!==2}>{body}</p>)}</div><p class="lab-fineprint">{L('Generic exploded model, not to scale. Actual construction varies by product. Cap and liner are removable; the model is not a test report.','通用分层示意，不按真实厚度比例绘制。具体结构以产品资料为准，表面保护膜和离型膜为可移除层。')}</p></div>
   <div data-lab-controls="window" hidden><div class="lab-demo-label">{L('INTERACTIVE EXAMPLE · NOT PRODUCT TEST DATA','交互示例 · 非产品实测数据')}</div><h3>{L('UV, light and heat.','防晒、透光与隔热。')}</h3><p class="lab-control-intro">{L('Adjust each example independently to understand what the metrics describe.','分别调整演示值，理解三个指标各自代表什么。')}</p><div class="lab-optical-control"><label class="lab-range-label" for="lab-uv"><span><i class="ray-dot uv"></i>{L('UV rejection','UV 阻隔率')}</span><output data-optical-output="uv">95%</output></label><input id="lab-uv" data-optical="uv" type="range" min="0" max="100" value="95" step="1"/><small>{L('UV prevented from passing through','未透过的紫外线比例')}</small></div><div class="lab-optical-control"><label class="lab-range-label" for="lab-vlt"><span><i class="ray-dot visible"></i>{L('Visible light · VLT','可见光透射比 VLT')}</span><output data-optical-output="vlt">70%</output></label><input id="lab-vlt" data-optical="vlt" type="range" min="5" max="90" value="70" step="1"/><small>{L('Visible light transmitted through','透过的可见光比例')}</small></div><div class="lab-optical-control"><label class="lab-range-label" for="lab-tser"><span><i class="ray-dot solar"></i>{L('Solar energy rejection · TSER','太阳能总阻隔率 TSER')}</span><output data-optical-output="tser">45%</output></label><input id="lab-tser" data-optical="tser" type="range" min="0" max="80" value="45" step="1"/><small>{L('Total solar energy kept out','被阻隔的总太阳能比例')}</small></div><p class="lab-math" aria-live="polite" data-uv-result>{L('For every 100 UV units: 95 blocked, 5 transmitted.','每 100 份入射 UV：阻隔 95 份，透过 5 份。')}</p><p class="lab-fineprint">{L('The three lanes explain separate metrics, not a combined energy budget or a performance prediction. UV rejection is not heat rejection. Confirm product data on the specified glass.','三条光路用于分别说明指标，不是同一能量预算或性能预测。隔 UV 不等于隔热；实际参数需结合对应玻璃的检测报告确认。')}</p><a class="text-link" href={path('/products/?category=Window%20film')}>{L('Explore window films','查看汽车窗膜')} ↗</a></div>
  </div>
 </div></div></div>
</section>
<script>import '../scripts/film-lab';</script>
