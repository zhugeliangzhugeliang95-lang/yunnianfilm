---
import { content } from '../../data/i18n';

import Layout from '../../layouts/Layout.astro';
import Product from '../../components/Product.astro';
import CTA from '../../components/CTA.astro';
import CatalogCompare from '../../components/CatalogCompare.astro';
import {categories,categoryUrl,catalogCategory} from '../../data/categories';
import {finishes} from '../../data/catalog';
const {lang,t,path,products}=content(Astro.url);
---
<Layout title={t("Explore our automotive films")}>
  <section class="container page-intro catalog-heading"><span class="eyebrow">YUNNIAN / PRODUCTS</span><h1>{lang==='zh'?'产品中心':'Our Film Collections'}</h1><p>{lang==='zh'?'先选用途，再比较基材、质感与厚度。':'Choose An Application. Compare Materials, Finishes And Thicknesses.'}</p></section>
  <div class="container"><a class="text-link" href={path('/color-studio/')}>{lang==='zh'?'按颜色选购：查看 404 款现有色卡':'Shop By Color: Explore 404 Product Cards'} ↗</a></div>
  <section class="container catalog"><div class="catalog-toolbar"><div class="filters" role="group" aria-label={t("Filter products")}>{['All films',...categories.map(c=>c.key)].map((c,i)=><button data-filter={c} aria-pressed={i===0?'true':'false'}>{c==='All films'?t(c):catalogCategory(c,lang)} <small>{c==='All films'?products.length:products.filter(p=>p.category===c).length}</small></button>)}</div><label class="search"><span class="sr-only">{t("Search films")}</span><input id="product-search" type="search" placeholder={lang==='zh'?'搜索型号、产品或材料，例如 IR7595HD':'Search model, film or material, e.g. IR7595HD'} maxlength="100"/><span aria-hidden="true">⌕</span></label></div><div class="category-context" aria-live="polite"><div data-category-context="All films"><span class="eyebrow">{lang==='zh'?'01 类别 → 02 系列 → 03 颜色与规格':'01 FAMILY → 02 SERIES → 03 COLOR & SPECIFICATION'}</span><h2>{lang==='zh'?'按用途选膜，再找到您的系列。':'Find the application. Then the right series.'}</h2><p>{lang==='zh'?'按车身、玻璃、建筑或两轮车用途查找，也可以直接搜索型号，例如 IR7595HD。':'Browse by surface and application, or look up a model directly, such as IR7595HD.'}</p></div>{categories.map(c=><div data-category-context={c.key} hidden><span class="eyebrow">{c.code} / {lang==='zh'?'产品类别':'FILM FAMILY'}</span><h2>{c[lang]}</h2><p>{c.detail[lang==='zh'?1:0]}</p><div class="subcategory-links">{products.filter(p=>p.category===c.key).map(p=><a href={path('/products/'+p.slug+'/')}>{p.name}<span>↗</span></a>)}</div></div>)}</div><div class="catalog-refine"><label>{lang==='zh'?'质感 / 外观':'Finish / appearance'}<select id="finish-filter"><option value="">{lang==='zh'?'全部质感':'All finishes'}</option>{finishes.map(([value,en,zh])=><option value={value}>{lang==='zh'?zh:en}</option>)}</select></label><label>{lang==='zh'?'标示厚度':'Listed thickness'}<select id="thickness-filter"><option value="">{lang==='zh'?'全部厚度':'All thicknesses'}</option>{['2','3','4','6.3','6.5','7','7.5','8.5','9','9.5'].map(v=><option value={v}>{v} mil</option>)}</select></label><button id="reset-filters" type="button">{lang==='zh'?'清除筛选':'Reset filters'} ↺</button><p>{lang==='zh'?'可选 2–3 款并排对比。':'Select 2–3 films to compare side by side.'}</p></div><p id="result-count" class="result-count" aria-live="polite">{lang==='zh'?`${products.length} 款产品`:`${products.length} films`}</p><div class="product-grid catalog-grid">{products.map((p,i)=><Product product={p} index={i} compare/>)}</div><div id="empty-state" class="empty-state" hidden><p>{t("No films match this search. Try another material or choose All films.")}</p><button id="empty-reset" class="text-link" type="button">{lang==='zh'?'重置筛选并查看全部':'Reset and view all films'} ↗</button></div><div class="catalog-help"><h3>{t("Looking for something else?")}</h3><p>{lang==='zh'?'需要建筑膜、施工工具或其他系列？可提交用途与采购需求，咨询对应产品资料。':'Looking for architectural films, installation tools or another range? Share your application and purchasing requirements.'}</p><a class="text-link" href={path("/contact/?intent=Other%20film%20request")}>{t("Tell us what you need ↗")}</a></div></section><CTA />
  <CatalogCompare />
  <script type="application/json" id="catalog-data" set:html={JSON.stringify(products.map(p=>({slug:p.slug,name:p.name,image:p.image,category:t(p.category),materials:p.materials,specs:p.specs,optionLabels:p.optionLabels}))).replace(/</g,'\\u003c')} />
  <script>import '../../scripts/catalog';</script>
</Layout>
