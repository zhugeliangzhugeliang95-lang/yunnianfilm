---
import Layout from '../../layouts/Layout.astro';
import Product from '../../components/Product.astro';
import SourceText from '../../components/SourceText.astro';
import collections from '../../data/collection-index.json';
import {categoryUrl} from '../../data/categories';
import {content} from '../../data/i18n';
import '../../styles/source-library.css';
export function getStaticPaths(){return Object.entries(collections).map(([slug,c])=>({params:{slug},props:{c}}));}
const {lang,path,products}=content(Astro.url),z=lang==='zh';
const {c}=Astro.props;
const members=c.members.map(slug=>products.find(p=>p.slug===slug)).filter(Boolean);
---
<Layout title={z?c.zh:c.title}><header class="container page-intro"><a class="text-link" href={path('/collections-guide/')}>← {z?'系列索引':'Collection index'}</a><h1>{z?c.zh:c.title}</h1>{z&&<p>{c.intro}</p>}</header><section class="container source-section">{z?<details class="library-fold"><summary>原版英文系列说明</summary><div lang="en"><SourceText html={c.body}/></div></details>:<SourceText html={c.body}/>}
 {members.length>0&&<div class="product-grid collection-members">{members.map((p,i)=><Product product={p} index={i}/>)}</div>}<div class="service-links">{c.category&&<a href={path(categoryUrl(c.category))}>{z?'浏览当前分类':'Browse the current film category'} ↗</a>}<a href={path('/contact/?'+new URLSearchParams({intent:'Other film request',message:c.title}))}>{z?'咨询这个系列':'Ask about this collection'} ↗</a></div></section></Layout>
<style>.collection-members{margin-block:2rem}</style>
