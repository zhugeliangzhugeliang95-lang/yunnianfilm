---
import Layout from '../../layouts/Layout.astro';
import collections from '../../data/collection-index.json';
import {content} from '../../data/i18n';
import {tpuPagePath} from '../../locales/tpu';
import '../../styles/source-library.css';
const {lang,path,products}=content(Astro.url),z=lang==='zh';
const entries = Object.entries(collections).map(([slug, collection]) => {
  const isClear = collection.category === 'Clear PPF';
  return {
    href: isClear ? tpuPagePath : '/collections-guide/' + slug + '/',
    label: z ? (isClear ? 'TPU 隐形车衣' : collection.zh) : collection.title,
    count: isClear ? products.filter(p => p.category === 'Clear PPF').length : collection.members.length,
  };
});
---
<Layout title={z?'原商城系列索引':'Original collection index'}><header class="container page-intro"><span class="eyebrow">YUNNIAN / COLLECTIONS</span><h1>{z?'系列索引':'Collection index'}</h1><p>{z?'查找原商城的产品分类，以及施工工具、反光膜和蓄光膜的项目资料。':'Browse the original store’s collections, including project ranges for tools, reflective materials and glow film.'}</p></header><section class="container source-section"><ul class="source-list">{entries.map(entry => <li><a href={path(entry.href)}>{entry.label} ↗</a><p>{entry.count ? (z ? entry.count+' 个系列' : entry.count+' series') : (z?'项目资料与询价':'Project information & inquiries')}</p></li>)}</ul><a class="text-link" href={path('/products/')}>{z?'查看完整产品目录':'Explore all products'} ↗</a></section></Layout>
