---
import { content } from '../data/i18n';
import {categories} from '../data/categories';

import Layout from '../layouts/Layout.astro';
const {lang,t,path,company,products,faqs}=content(Astro.url);
---
<Layout title={t("Request samples or a wholesale quote")}>
  <section class="container page-intro"><span class="eyebrow">{t("LET’S START SOMETHING")}</span><h1>{t("Good partnerships")}<br />{t("start here.")}</h1><p>{t("Samples, wholesale supply or your next OEM project.")}<br />{t("Tell us what you have in mind.")}</p></section>
  <section class="container contact-layout"><aside><span class="eyebrow">{t("DIRECT TO OUR TEAM")}</span><h3>{t("Talk film with us.")}</h3><a class="contact-email" href={`mailto:${company.email}`}>{company.email}</a><a class="text-link" href={`https://wa.me/${company.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp · {company.phone} ↗</a><div class="contact-location"><span class="eyebrow">{t("FIND US")}</span><p>{company.name}</p><p>{company.address}</p></div></aside>
    <form id="inquiry-form" class="inquiry-form"><div class="form-heading"><h2>{t("Your inquiry")}</h2><span>{t("* Required fields")}</span></div><section id="inquiry-colors" class="inquiry-colors" hidden aria-labelledby="inquiry-colors-title"><div><span class="eyebrow">{lang==='zh'?'核对您的选色':'YOUR COLOR SELECTION'}</span><h3 id="inquiry-colors-title">{lang==='zh'?'已选现有颜色':'Selected existing colors'} · <span id="inquiry-color-count"></span></h3><p>{lang==='zh'?'请核对原始色卡。编号、英文名称与对应质感会写入询价，最终以实物样品为准。':'Check the original cards below. References, English names and finishes are included in your inquiry. Confirm with physical samples.'}</p></div><div id="inquiry-color-grid" class="inquiry-color-grid"></div><a class="text-link" href={path('/color-studio/')}>{lang==='zh'?'返回色卡目录':'Return to color catalog'} ↗</a></section><div class="form-grid"><label>{t("Full name *")}<input name="name" autocomplete="name" required maxlength="100" placeholder={t("Your name")}/></label><label>{t("Business email *")}<input name="email" type="email" autocomplete="email" required maxlength="150" placeholder="you@company.com"/></label><label>{t("Company *")}<input name="company" autocomplete="organization" required maxlength="150" placeholder={t("Company name")}/></label><label>{t("Country / region *")}<input name="country" autocomplete="country-name" required maxlength="100" placeholder={t("Your market")}/></label><label>{t("Product interest")}<select name="product"><option value="">{t("Help me choose")}</option>{categories.map(c=><optgroup label={c[lang]}>{products.filter(p=>p.category===c.key).map(p=><option value={p.originalName} data-product-slug={p.slug}>{p.name}</option>)}</optgroup>)}<option value="TPU Color PPF · Color Catalog">{lang==='zh'?'TPU 改色膜 · 现有颜色目录':'TPU Color PPF · Color Catalog'}</option><option value="Other films / tools">{t("Other films / tools")}</option></select></label><label>{t("Inquiry type")}<select name="intent"><option value="Wholesale quote">{t("Wholesale quote")}</option><option value="Sample request">{t("Sample request")}</option><option value="OEM cooperation">{t("OEM cooperation")}</option><option value="Other film request">{t("Other film request")}</option></select></label><label>{t("Variant / finish")}<input name="variant" maxlength="150" placeholder={t("Thickness, color or finish")}/></label><label>{t("Estimated quantity")}<input name="quantity" maxlength="100" placeholder={t("e.g. 10 rolls / sample book")}/></label><label>{lang==='zh'?'样品需求（选填）':'Sample preference (optional)'}<select name="sample"><option value="">{lang==='zh'?'请协助推荐':'Please recommend'}</option><option value="Color swatches">{lang==='zh'?'色卡 / 颜色小样':'Color swatches'}</option><option value="Film for installation evaluation">{lang==='zh'?'施工评估用膜样':'Film for installation evaluation'}</option><option value="Both swatches and film samples">{lang==='zh'?'色卡及膜样':'Both swatches and film samples'}</option></select></label><label>{lang==='zh'?'目的地城市 / 邮编（选填）':'Destination city / postcode (optional)'}<input name="destination" maxlength="150" autocomplete="off" placeholder={lang==='zh'?'便于确认运输安排':'For shipping arrangements'}/></label><label class="full">{t("Project details")}<textarea name="message" maxlength="2000" rows="4" placeholder={t("Tell us about your application, packaging and destination.")}></textarea></label></div><p class="form-note">{t("Your details are used to prepare an inquiry. Choose email or WhatsApp, review the message there, then send it. This form does not submit or store your information.")}</p><label class="consent"><input type="checkbox" name="consent" required/><span>{t("I agree to include these details in my inquiry and have read the")} <a href={path("/privacy/")}>{t("privacy notice")}</a>{lang==='zh'?'。 *':'. *'}</span></label><div class="form-actions"><button class="button button-accent" type="submit">{t("Prepare my inquiry")} <span>↗</span></button></div><div id="inquiry-result" class="inquiry-result" hidden tabindex="-1"><span class="eyebrow">{t("READY FOR YOUR REVIEW")}</span><h3>{t("Your message is prepared.")}</h3><p>{t("Choose a channel below. You will review and send the message in your email app or WhatsApp.")}</p><div class="result-actions"><a id="email-inquiry" class="button button-dark" href={`mailto:${company.email}`}>{t("Open email ↗")}</a><a id="whatsapp-inquiry" class="button button-outline" href={`https://wa.me/${company.whatsapp}`} target="_blank" rel="noopener noreferrer">{t("Open WhatsApp ↗")}</a><button id="copy-inquiry" type="button" class="text-link">{t("Copy message")}</button></div><pre id="message-preview"></pre><p id="copy-status" role="status"></p></div><noscript><p>{t("Please email")} <a href={`mailto:${company.email}`}>{company.email}</a> {t("with your product requirements.")}</p></noscript></form>
  </section><section class="section container faq-layout"><div><span class="eyebrow">{t("USEFUL TO KNOW")}</span><h2>{t("Before your")}<br />{t("first order.")}</h2></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
  <script>
    import {setupInquiryColors} from '../scripts/inquiry-colors';
    import { translate, canonicalValue } from '../data/translate';
    const chinese=document.documentElement.lang==='zh-CN';
    const t=(value:string)=>translate(chinese?'zh':'en',value);
    const form=document.querySelector<HTMLFormElement>('#inquiry-form')!;const params=new URLSearchParams(location.search);
    for(const key of ['product','variant','intent']){const field=form.elements.namedItem(key) as HTMLInputElement|HTMLSelectElement;const val=params.get(key);if(val&&field){if(field instanceof HTMLSelectElement){if(Array.from(field.options).some(o=>o.value===val))field.value=val;}else field.value=t(val.slice(0,150));}}
    const inquiryColors=setupInquiryColors(form,chinese);
    const topic=params.get('message')?.trim().slice(0,240);
    if(topic) (form.elements.namedItem('message') as HTMLTextAreaElement).value=(chinese?'希望咨询系列：':'I would like to discuss the collection: ')+topic;
    const choices=Array.from(form.querySelectorAll<HTMLOptionElement>('option[data-product-slug]'));
    const requestedSelection=[...new Set((params.get('selection')||'').split(','))].slice(0,3).map(slug=>choices.find(option=>option.dataset.productSlug===slug)).filter(Boolean);
    if(requestedSelection.length){const message=form.elements.namedItem('message') as HTMLTextAreaElement;message.value=(chinese?'希望评估以下产品样品：':'I would like to evaluate samples of:')+'\n'+requestedSelection.map(option=>'• '+option!.textContent).join('\n')+'\n\n'+(chinese?'请确认可选规格、样品费用与运输安排。':'Please confirm available variants, sample costs and shipping.');}
    function updateInquiryLanguageLinks(){
      const data=new FormData(form);
      document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach(a=>{
        const url=new URL(a.href);
        for(const key of ['product','variant','intent']){
          const value=canonicalValue(String(data.get(key)||'').trim());
          if(value)url.searchParams.set(key,value);else url.searchParams.delete(key);
        }
        a.href=url.toString();
      });
    }
    form.addEventListener('input',updateInquiryLanguageLinks);
    form.addEventListener('change',()=>{updateInquiryLanguageLinks();document.querySelector<HTMLElement>('#inquiry-result')!.hidden=true;});
    let body='';form.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const v=(key:string)=>String(data.get(key)||'').trim();body=chinese?`云辇团队，您好：\n\n咨询类型：${t(v('intent'))}\n\n产品：${t(v('product'))||'请协助推荐'}\n规格 / 质感：${t(v('variant'))||'待沟通'}\n数量：${v('quantity')||'待沟通'}\n\n姓名：${v('name')}\n公司：${v('company')}\n国家 / 地区：${v('country')}\n邮箱：${v('email')}\n\n项目需求：\n${v('message')||'请联系我沟通具体需求。'}`:`Hello YUNNIAN team,\n\nI would like to discuss: ${v('intent')}\n\nProduct: ${v('product')||'Please recommend'}\nVariant / finish: ${v('variant')||'To discuss'}\nQuantity: ${v('quantity')||'To discuss'}\n\nName: ${v('name')}\nCompany: ${v('company')}\nCountry / region: ${v('country')}\nEmail: ${v('email')}\n\nProject details:\n${v('message')||'Please contact me to discuss the details.'}`;const colors=inquiryColors();if(colors)body+='\n\n'+colors;const samples:Record<string,string>={'Color swatches':'色卡 / 颜色小样','Film for installation evaluation':'施工评估用膜样','Both swatches and film samples':'色卡及膜样'};if(v('sample'))body+='\n\n'+(chinese?'样品需求：'+samples[v('sample')]:'Sample preference: '+v('sample'));if(v('destination'))body+='\n'+(chinese?'目的地城市 / 邮编：':'Destination city / postcode: ')+v('destination');body+='\n\n'+(chinese?'请确认当前供应、样品费用及运输安排。':'Please confirm current availability, sample costs and shipping arrangements.');document.querySelector<HTMLAnchorElement>('#email-inquiry')!.href=`mailto:yunnianfilm@gmail.com?subject=${encodeURIComponent('YUNNIAN '+t(v('intent'))+' — '+v('company'))}&body=${encodeURIComponent(body)}`;document.querySelector<HTMLAnchorElement>('#whatsapp-inquiry')!.href=`https://wa.me/8619880968878?text=${encodeURIComponent(body)}`;document.querySelector('#message-preview')!.textContent=body;const result=document.querySelector<HTMLElement>('#inquiry-result')!;result.hidden=false;result.focus({preventScroll:true});result.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'center'});});
    form.addEventListener('input',()=>{document.querySelector<HTMLElement>('#inquiry-result')!.hidden=true;document.querySelector('#copy-status')!.textContent='';});
    document.querySelector('#copy-inquiry')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(body);document.querySelector('#copy-status')!.textContent=chinese?'已复制询价内容，可粘贴到您常用的邮件应用中。':'Message copied. You can paste it into your preferred email app.';}catch{document.querySelector('#copy-status')!.textContent=chinese?'当前环境无法自动复制，请选中上方内容手动复制。':'Copy is unavailable here. Select and copy the message shown above.';}});
  </script>
</Layout>
