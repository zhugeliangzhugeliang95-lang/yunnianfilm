---
import CategoryDirectory from '../components/CategoryDirectory.astro';
import FilmLab from '../components/FilmLab.astro';
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import FilmFinder from '../components/FilmFinder.astro';
import { content } from '../data/i18n';
import { editorial } from '../data/editorial';
const {lang,path,products}=content(Astro.url);
const {L,families}=editorial(lang);
const compare=[
 [L('Primary application','主要应用'),L('Original paint appearance','保留原车漆面外观'),L('Color change + paint protection','改色与漆面保护'),L('Automotive glass','汽车玻璃')],
 [L('Selection starts with','选型关注点'),L('Substrate, thickness, topcoat','基材、厚度、表面涂层'),L('Color, finish, installation area','颜色、质感、施工部位'),L('Shade, optical data, local rules','颜色、光学参数、当地要求')],
 [L('Evaluate with','建议评估方式'),L('Film sample + installation trial','膜材样品与施工试贴'),L('Physical swatch + film sample','实物色卡与膜材样品'),L('Shade sample + technical sheet','颜色样品与技术资料')],
];
const checks=[
 [L('Define the application','明确应用场景'),L('Confirm the surface, installation area and the appearance you want to achieve. A full wrap and an individual panel may need different order quantities.','确认施工表面、覆盖范围与希望呈现的外观。全车施工和单个面板所需的采购数量可能不同。')],
 [L('Evaluate a physical sample','评估实物样品'),L('Review the finish under different lighting and test the material with your own installation process. Screen colors cannot replace a physical sample.','在不同光线下观察质感，并结合自身施工流程进行试贴。屏幕色彩不能代替实物样品。')],
 [L('Ask for product-specific documents','索取对应产品资料'),L('Request the current technical data sheet and written warranty terms for the exact variant and batch. For window film, confirm local requirements before ordering.','针对具体规格与批次，索取最新技术资料和书面质保条款。窗膜产品请在采购前确认当地要求。')],
 [L('Confirm the complete quotation','确认完整报价'),L('Agree on the variant, roll size, quantity, packaging, destination, lead time and shipping terms before placing an order.','下单前，请确认规格、卷材尺寸、数量、包装、目的地、交期与运输条款。')],
];
---
<Layout title={L('The automotive film selection guide','汽车膜选型指南')} description={L('Compare clear PPF, color PPF and automotive window film. Explore substrates, sample evaluation and the details to confirm before your first order.','比较透明车衣、彩色车衣与汽车窗膜，了解基材选型、样品评估及首次采购前需要确认的细节。')}>
  <section class="guide-hero container"><div><span class="eyebrow">YUNNIAN / {L('THE FILM GUIDE','汽车膜选型指南')}</span><h1>{L('A little clarity.','多一分了解。')}<br /><span>{L('A better starting point.','多一分从容。')}</span></h1><p>{L('Understand the families. Explore the materials. Choose with a sample.','了解产品系列，比较材料，通过样品做出选择。')}</p><a class="text-link" href="#finder-title">{L('Find your direction','找到您的方向')} <span aria-hidden="true">↓</span></a></div><div class="guide-hero-image"><img src="/images/film-craft-v3.webp" alt={L('Illustrative clear film installation detail','透明膜施工细节示意图')} width="1600" height="1067"/><span>{L('ILLUSTRATIVE APPLICATION SCENE','应用场景示意')}</span></div></section>
  <CategoryDirectory />
  <FilmFinder />
  <section class="container section guide-compare"><div class="section-heading"><div><span class="eyebrow">02 / {L('AT A GLANCE','快速了解')}</span><h2>{L('Three core choices.','三类常见需求。')}<br />{L('Different purposes.','各有所长。')}</h2></div><p class="heading-description">{L('A category-level overview. Confirm the exact specifications for the product you select.','以下为类别对比，具体参数请以所选产品资料为准。')}</p></div><div class="comparison-scroll" tabindex="0" role="region" aria-label={L('Film family comparison','产品系列对比表')}><table class="comparison-table"><thead><tr><th scope="col">{L('What to consider','比较项目')}</th>{families.map(f=><th scope="col"><span>{f.number}</span>{f.title}</th>)}</tr></thead><tbody>{compare.map(([label,...cells])=><tr><th scope="row">{label}</th>{cells.map(cell=><td>{cell}</td>)}</tr>)}<tr><th scope="row">{L('Next step','继续了解')}</th>{families.map(f=><td><a href={path(f.destination)}>{L('View range','查看系列')} ↗</a></td>)}</tr></tbody></table></div><p class="mobile-table-note">{L('Swipe the table horizontally to compare all three families.','左右滑动表格，查看三个系列的对比。')}</p></section>
  <FilmLab initialMode="ppf" embedded/>
  <section class="substrate-guide container section"><div><span class="eyebrow">04 / {L('CLEAR PPF MATERIALS','透明车衣基材')}</span><h2>{L('Start with','从基材开始，')}<br />{L('the substrate.','找到合适组合。')}</h2><p>{L('Three substrate ranges in the current collection. Thickness and coating options vary by product.','当前产品中心提供三个基材系列，厚度与涂层选项因产品而异。')}</p></div><div class="substrate-list">{products.filter(p=>p.category==='Clear PPF').map((p,i)=><a href={path(`/products/${p.slug}/`)}><span class="eyebrow">0{i+1} / TPU</span><h3>{p.name}</h3><p>{p.specs.find(([key])=>key===(lang==='zh'?'厚度':'Thickness'))?.[1]}</p><span class="substrate-arrow" aria-hidden="true">↗</span></a>)}</div></section>
  <section class="container section before-order"><div><span class="eyebrow">05 / {L('BEFORE YOU ORDER','采购之前')}</span><h2>{L('Good questions.','把问题问清。')}<br />{L('Clear expectations.','把细节确认。')}</h2></div><div class="faq-list">{checks.map(([q,a],i)=><details open={i===0}><summary><span class="check-index">0{i+1}</span>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
  <section class="container specialist-note"><span class="eyebrow">{L('A DIFFERENT SURFACE?','还有其他施工部位？')}</span><p>{L('Headlights and exterior windshields need product-specific evaluation. Browse the specialty range and confirm compatibility and local requirements.','大灯与外侧前挡玻璃需要针对具体型号评估。查看专用膜系列，并确认适配性与当地要求。')}</p><a class="text-link" href={path('/products/?category=Windshield%20protection')}>{L('Explore windshield protection','查看前挡保护膜')} ↗</a></section>
  <CTA title={L('Let’s find\nyour starting point.','一起找到\n合适的开始。')} text={L('Share your application and market. We will help you discuss the next sample to evaluate.','告诉我们您的应用场景与目标市场，一起沟通下一份待评估的样品。')} />
</Layout>
