---
import Layout from '../layouts/Layout.astro';import CTA from '../components/CTA.astro';import {content} from '../data/i18n';import {editorial} from '../data/editorial';
const {lang,path}=content(Astro.url);const {L}=editorial(lang);
const resources=[
 {label:L('DOCUMENTS','资料'),title:L('Buyer services and reports','采购服务与检测报告'),text:L('Find sample report PDFs, shipping guidance and original store policies.','查阅送检样品的报告、运输说明和原商城服务条款。'),href:path('/buyer-services/'),cta:L('Open buyer services','查看采购服务')},
 {label:L('COLLECTIONS','系列'),title:L('Collection index','产品系列索引'),text:L('Explore all nine original collections, including installation tools, reflective film and glow film.','查阅原商城九个分类，包含施工工具、反光膜与蓄光膜。'),href:path('/collections-guide/'),cta:L('Explore collections','查看系列')},
 {label:L('GUIDE / INTERACTIVE','指南 / 交互选型'),title:L('The film selection guide','汽车膜选型指南'),text:L('Compare clear PPF, color PPF and automotive window film by purpose and the questions to ask.','按用途比较透明车衣、彩色车衣和汽车窗膜，了解选型时需要确认的事项。'),href:path('/film-guide/'),cta:L('Read the guide','阅读指南')},
 {label:L('CHECKLIST / TEXT FILE','清单 / 文本文件'),title:L('Sample evaluation checklist','样品评估清单'),text:L('A practical record for sample identity, visual review, installation notes and purchasing questions.','记录样品型号、外观比较、施工反馈及采购问题，方便团队统一评估。'),href:`/downloads/sample-checklist-${lang}.txt`,cta:L('Download checklist','下载清单'),download:true},
 {label:L('TEMPLATE / TEXT FILE','模板 / 文本文件'),title:L('Your OEM project brief','OEM 项目需求表'),text:L('Prepare your market, product, packaging and quantity requirements before a discussion.','提前整理销售市场、产品、包装与订货数量，使合作沟通更高效。'),href:`/downloads/oem-brief-${lang}.txt`,cta:L('Download template','下载模板'),download:true},
 {label:L('PRODUCT REFERENCE / IMAGE','产品参考 / 图片资料'),title:L('Lubrizol SM301 · 6.5 mil','路博润 SM301 · 6.5 mil'),text:L('Existing supplier specification image for this listed variant. Confirm the latest version and applicable terms for your order.','现有资料中的该规格参数图。下单前请确认最新版本及适用于订单的具体条款。'),href:'/images/spec.webp',cta:L('View reference','查看资料')},
 {label:L('REQUEST / PRODUCT-SPECIFIC','咨询 / 按型号确认'),title:L('Data for your exact product','所选型号的具体资料'),text:L('Request the current specification, installation instructions and any applicable test or warranty documents. Availability depends on the product.','咨询当前规格、施工说明，以及适用的测试或质保文件；具体可提供资料以型号为准。'),href:path('/contact/'),cta:L('Ask the team','联系确认')}
];
const checks=[
 [L('Identify the sample','先确认样品身份'),L('Record the product, variant, thickness, lot reference and the date received. Keep packaging and labels with your notes.','记录产品名称、规格、厚度、批次参考及收样日期，保留包装标签，便于后续对应。')],
 [L('Compare the appearance','在实际光线下比较'),L('Review color and finish under natural and workshop lighting. Compare against your agreed reference and record observations.','分别在自然光和施工环境中查看颜色与质感，与约定的参考样进行对照并记录。')],
 [L('Review with your installation team','由施工团队共同评估'),L('Use the instructions supplied for that exact product. Note the surface, conditions, process and questions for the supplier.','遵循所选型号提供的施工说明，记录施工表面、环境、过程，以及需要向供应商确认的问题。')],
 [L('Confirm the commercial details','把采购条件写清楚'),L('Agree the specification, order quantity, packaging, delivery terms and applicable after-sales terms in writing.','以书面方式确认具体规格、订货数量、包装、交付条件及适用的售后条款。')]
];
const faq=[
 [L('How do I choose between clear and color PPF?','透明车衣和彩色车衣如何选择？'),L('Start with the desired appearance. Clear PPF is the starting point when you want to retain the original paint appearance; color PPF adds a color-selection decision. Evaluate the actual sample and the specific product data in either case.','从期望外观出发。希望保留原车本色时，可从透明车衣开始；彩色车衣则还需要确认颜色。两者都应结合实物样品与具体型号资料评估。')],
 [L('Can I rely on the colors shown on this website?','网站上的颜色能直接作为订货依据吗？'),L('Use website imagery and the color studio to make a shortlist. Screens, lighting and image processing affect appearance. Confirm the physical sample and agreed color reference before ordering.','网站图片与色彩工作室适合帮助初选。屏幕、光线及图片处理均会影响观感，订货前请确认实物样品与双方约定的颜色参考。')],
 [L('What should I include in a quotation request?','询价时需要提供哪些信息？'),L('Include the product or application, preferred variant, roll size, quantity, destination, packaging requirements and target schedule. If a detail is undecided, say so and ask for the available options.','建议提供产品或应用、意向规格、卷材尺寸、数量、目的地、包装要求和期望时间。尚未确定的内容可以说明，并咨询可选方案。')],
 [L('Are sample costs and order minimums fixed?','样品费用和起订量固定吗？'),L('Confirm these for the chosen product and destination. Sample availability, freight, order minimums and lead times are discussed as part of the inquiry; this site does not publish a fixed offer for them.','需结合所选产品与目的地确认。样品供应、运费、起订量和交期均在询盘中讨论，网站未对这些项目给出统一固定报价。')],
 [L('How are specifications and warranty terms confirmed?','参数与质保条款如何确认？'),L('Ask for documents that identify the exact product and variant, with the applicable version or date. Confirm any exclusions, conditions and claim process in the written agreement for your order.','请索取明确对应产品与规格、带版本或日期的资料，并在订单书面约定中确认适用条件、除外事项和售后处理流程。')],
 [L('Can I place and pay for an order here?','可以直接在网站下单付款吗？'),L('This website supports product discovery and inquiry preparation. Your inquiry can be opened in your email or WhatsApp app for you to send. Orders, pricing and payment are arranged separately after confirmation.','本网站用于产品了解和询盘整理。整理好的询盘可在您的邮件或 WhatsApp 中打开，由您确认发送；订单、报价和付款在双方确认后另行安排。')]
];
---
<Layout title={L('Resources & buying guide','资料与采购指南')} description={L('Practical YUNNIAN product selection resources, a sample evaluation checklist, OEM project brief and answers to common purchasing questions.','云辇产品选型资料、样品评估清单、OEM 需求模板及常见采购问题。')}>
<section class="container page-intro resources-intro"><div><span class="eyebrow">YUNNIAN / RESOURCES</span><h1>{L('A clearer brief.','把需求理清，')}<br />{L('A better conversation.','让合作更顺畅。')}</h1></div><p>{L('Practical starting points for selection, sample review and your next product discussion.','从选型、样品评估到产品沟通，为下一步采购准备实用资料。')}</p></section>
<section class="container resource-list" aria-label={L('Resources library','资料目录')}>{resources.map((r,i)=><article class="resource-row"><span class="resource-number">0{i+1}</span><div><span class="eyebrow">{r.label}</span><h2>{r.title}</h2></div><p>{r.text}</p><a class="text-link" href={r.href} download={r.download?true:undefined}>{r.cta} <span aria-hidden="true">{r.download?'↓':'↗'}</span></a></article>)}</section>
<section class="resource-checklist section container"><div><span class="eyebrow">01 / {L('A SAMPLE, REVIEWED WELL','让样品评估有据可循')}</span><h2>{L('Four steps to','四个步骤，')}<br />{L('a useful evaluation.','做好样品评估。')}</h2><p>{L('A working checklist for your own team. Agree product-specific test methods and acceptance criteria with the supplier.','供您的团队记录使用。具体测试方法及验收标准，应与供应商针对型号共同确认。')}</p></div><ol>{checks.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol></section>
<section class="container section resource-faq"><div><span class="eyebrow">02 / {L('BEFORE WE BEGIN','合作之前')}</span><h2>{L('Useful answers.','提前了解，')}<br />{L('Fewer unknowns.','减少疑问。')}</h2></div><div class="faq-list">{faq.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
<CTA title={L('Ready to define\nyour next order?','一起明确，\n您的下一笔采购。')} text={L('Bring your shortlist, questions and project brief. Start with a product conversation.','带上产品意向、问题与项目需求，从一次具体的产品沟通开始。')}/>
</Layout>
