---
import {company} from '../../../data/products';
---
<!doctype html>
<html lang="en" data-hosted="true">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/support/chat.css">
  <title>Ask YUNNIAN</title>
</head>
<body>
  <main class="chat" aria-labelledby="brand">
    <header class="masthead">
      <h1 id="brand"><img src="/images/yunnian-logo-white.webp" width="126" height="32" alt="YUNNIAN"></h1>
      <span id="mode">AI film support</span>
    </header>
    <div class="thread" id="thread">
      <section class="welcome" id="welcome" aria-labelledby="welcome-title">
        <div class="cover"><h2 id="welcome-title">Which film are you looking for?</h2></div>
        <div class="examples" aria-label="Suggested questions">
          <button type="button" data-example="find" disabled>Find a window film</button>
          <button type="button" data-example="compare" disabled>Compare two models</button>
        </div>
      </section>
      <div id="messages" role="log" aria-live="polite" aria-relevant="additions"></div>
    </div>
    <div class="controls">
      <form id="chat-form">
        <textarea id="message" rows="1" maxlength="4000" aria-label="Your message" placeholder="Ask about a film…" required></textarea>
        <button type="submit" id="send" disabled>Send</button>
      </form>
      <details id="contact-panel">
        <summary>Contact the team</summary>
        <div class="sales-links">
          <a href={`mailto:${company.email}`} target="_blank" rel="noopener noreferrer"><span id="sales-email-label">Email</span><bdi>{company.email}</bdi></a>
          <a href={`https://wa.me/${company.whatsapp}`} target="_blank" rel="noopener noreferrer"><span>WhatsApp</span><bdi>{company.phone}</bdi></a>
          <a href={`tel:+${company.whatsapp}`} target="_blank" rel="noopener noreferrer"><span id="sales-phone-label">Phone</span><bdi>{company.phone}</bdi></a>
        </div>
        <form id="contact-form">
          <label for="contact" id="contact-label">Your email and enquiry</label>
          <textarea id="contact" rows="2" maxlength="1000" required></textarea>
          <button type="submit" disabled>Send to the team</button>
          <p id="saved" role="status"></p>
        </form>
      </details>
      <div id="notice"><span id="privacy-note">Groq processes this chat. Messages are saved for support.</span> <a id="privacy-link" href="/privacy/" target="_blank" rel="noopener">Privacy</a></div>
    </div>
  </main>
  <script is:inline src="/support/chat.js"></script>
</body>
</html>
