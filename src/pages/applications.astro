---
import Layout from '../layouts/Layout.astro';import CTA from '../components/CTA.astro';import {content} from '../data/i18n';import {editorial} from '../data/editorial';
const {lang,path}=content(Astro.url);const {L}=editorial(lang);
const applications=[
 {n:'01',label:L('ORIGINAL PAINT / CLEAR PPF','原车漆面 / 透明车衣'),title:L('Keep the character.','保留原车本色。'),body:L('Start with transparent PPF when preserving the original paint appearance is the priority. Match the substrate and thickness to your installation and purchasing requirements.','希望保留原车外观时，从透明隐形车衣开始选型。结合施工与采购需求，比较基材系列及膜厚。'),image:'film-craft-v3.webp',alt:L('Illustrative view of clear film over an automotive panel','透明膜覆于汽车面板的场景示意'),note:L('Illustrative application scene','应用场景示意'),rows:[[L('Surface','应用部位'),L('Painted exterior panels','车身外部漆面')],[L('Explore','可选方向'),L('Lubrizol, BASF and Covestro TPU ranges','路博润、巴斯夫与科思创 TPU 系列')],[L('Confirm','采购前确认'),L('Paint condition, thickness, finish and roll size','漆面状态、膜厚、质感及卷材尺寸')]],href:'/products/?category=Clear%20PPF',cta:L('Explore clear PPF','查看透明隐形车衣')},
 {n:'02',label:L('PERSONAL EXPRESSION / COLOR PPF','色彩表达 / 彩色车衣'),title:L('A new point of view.','让色彩，表达不同。'),body:L('Explore the Classic Color PPF palette for a different visual identity. Begin with a shortlist of colors, then use physical samples to compare finish and appearance under different light.','以经典原厂色彩色车衣探索新的视觉风格。先确定喜欢的颜色，再借助实物样品比较不同光线下的色彩与质感。'),image:'color-library.webp',alt:L('YUNNIAN color sample library','云辇实物颜色样板库'),note:L('Official YUNNIAN product imagery','云辇官方产品资料'),rows:[[L('Surface','应用部位'),L('Painted exterior panels','车身外部漆面')],[L('Explore','可选方向'),L('Classic colors and finish options','经典配色与可选质感')],[L('Confirm','采购前确认'),L('Color reference, finish and batch consistency','颜色参考、表面质感及批次一致性')]],href:'/color-studio/',cta:L('Enter the color studio','进入色彩工作室')},
 {n:'03',label:L('AUTOMOTIVE GLASS / WINDOW FILM','汽车玻璃 / 窗膜'),title:L('Consider every view.','认真对待，每一处视野。'),body:L('Select automotive window film by the intended glass position and visual requirements. Review the exact product data and local requirements for your market before choosing a tint.','结合玻璃位置和视觉需求选择汽车窗膜。确定颜色前，先核对具体型号资料及销售市场的适用要求。'),image:'window-film.webp',alt:L('YUNNIAN Ocean Blue automotive window film product image','云辇海洋蓝汽车窗膜产品图片'),note:L('Official YUNNIAN product imagery','云辇官方产品资料'),rows:[[L('Surface','应用部位'),L('Automotive glass; confirm intended position','汽车玻璃；需确认具体使用位置')],[L('Explore','可选方向'),L('Chameleon / Aurora window film','变色龙 / 极光窗膜系列')],[L('Confirm','采购前确认'),L('Visible light transmission, glass compatibility and local rules','可见光透过率、玻璃适配及当地要求')]],href:'/products/chameleon-aurora-window-film/',cta:L('Explore window film','查看汽车窗膜')}
];
const partners=[{title:L('For installers','施工门店'),text:L('Start with a sample selection and the installation information your team needs.','从样品组合和团队所需的施工资料开始沟通。'),href:'/contact/?intent=Sample%20request',label:L('SAMPLE & EVALUATION','样品与评估')},{title:L('For distributors','渠道经销商'),text:L('Discuss the product mix, target market, order quantities and repeat supply requirements.','讨论产品组合、目标市场、订货数量和持续供货需求。'),href:'/contact/',label:L('RANGE & SUPPLY','产品与供应')},{title:L('For your brand','品牌合作方'),text:L('Build an OEM brief covering specifications, packaging and your launch requirements.','围绕产品规格、包装与上市需求，整理 OEM 合作方案。'),href:'/oem/',label:L('OEM & PRIVATE LABEL','OEM 与品牌定制')}];
---
<Layout title={L('Film for every perspective','从场景出发，找到合适的膜')} description={L('Explore YUNNIAN film by application: original paint, color transformation and automotive glass. Find a starting point for installation, distribution or OEM cooperation.','按应用探索云辇产品：原车漆面、色彩表达与汽车玻璃，为施工、经销和 OEM 合作找到合适的起点。')}>
<section class="container page-intro"><span class="eyebrow">YUNNIAN / APPLICATIONS</span><h1>{L('Every surface.','每一处表面，')}<br />{L('A different possibility.','都有新的可能。')}</h1><p>{L('Begin with the application. Find the right product conversation.','先明确应用场景，再开始有针对性的产品沟通。')}</p></section>
<section class="container application-list" aria-label={L('Automotive film applications','汽车膜应用场景')}>{applications.map(a=><article class="application-row"><div class="application-image"><img src={'/images/'+a.image} width="1600" height="1400" loading="lazy" alt={a.alt}/><span>{a.note}</span></div><div class="application-copy"><span class="eyebrow">{a.n} / {a.label}</span><h2>{a.title}</h2><p>{a.body}</p><dl>{a.rows.map(([term,value])=><div><dt>{term}</dt><dd>{value}</dd></div>)}</dl><a class="text-link" href={path(a.href)}>{a.cta} <span aria-hidden="true">↗</span></a></div></article>)}</section>
<section class="partner-paths"><div class="container section"><div class="section-heading"><div><span class="eyebrow">04 / {L('BUILT AROUND YOUR BUSINESS','从您的业务需求出发')}</span><h2>{L('Your next step,','找到适合您的')}<br />{L('your way.','合作方式。')}</h2></div></div><div class="discover-list">{partners.map(p=><a class="discover-link" href={path(p.href)}><span class="eyebrow">{p.label}</span><h3>{p.title}</h3><p>{p.text}</p><span aria-hidden="true">↗</span></a>)}</div></div></section>
<CTA title={L('Have a specific\napplication in mind?','有明确的\n应用需求？')} text={L('Share the surface, target market and expected order. We can discuss a suitable starting range.','告诉我们应用部位、目标市场与预计订货量，一起讨论选型方向。')}/>
</Layout>
