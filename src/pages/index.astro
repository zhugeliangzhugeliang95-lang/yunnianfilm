---
import {siteLanguage} from '../locales/languages';
import {tpuCopy} from '../locales/tpu';
import Layout from '../layouts/Layout.astro';
import VideoHero from '../components/VideoHero.astro';
import HomeCollections from '../components/HomeCollections.astro';
import HomeColors from '../components/HomeColors.astro';
import FilmLab from '../components/FilmLab.astro';
import SampleJourney from '../components/SampleJourney.astro';
import BlogPreview from '../components/BlogPreview.astro';
import CustomerStories from '../components/CustomerStories.astro';
import CTA from '../components/CTA.astro';
const copy = tpuCopy[siteLanguage(Astro.url.pathname).id];
---
<Layout dark title={copy.homeTitle} description={copy.homeDescription}><VideoHero/><HomeCollections/><HomeColors/><FilmLab/><SampleJourney/><CustomerStories/><BlogPreview/><CTA/></Layout>
