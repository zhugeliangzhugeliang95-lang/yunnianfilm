---
import Layout from '../../layouts/Layout.astro';
import SourceText from '../../components/SourceText.astro';
import {content} from '../../data/i18n';
import {blogPosts} from '../../data/blog';
import originals from '../../data/journal-originals.json';
import '../../styles/source-library.css';
import {siteLanguage} from '../../locales/languages';
import {textIn} from '../../locales/copy';
import {tpuCopy, tpuPagePath} from '../../locales/tpu';
export function getStaticPaths(){return blogPosts.map(post=>({params:{slug:post.slug},props:{post}}));}
const {lang,path,products}=content(Astro.url);const z=lang==='zh';
const {post}=Astro.props,original=originals[post.slug as keyof typeof originals];
const product=original&&products.find(p=>p.slug===original.related);
const clearFilmGuide = ['tpu-vs-tph-full-comparison-of-paint-protection-films', 'understanding-ppf-layers', 'aromatic-vs-aliphatic-tpu-why-ppf-turns-yellow'].includes(post.slug);
const language = siteLanguage(Astro.url.pathname);
const copy = tpuCopy[language.id];
const articleText = (value: {en: string; zh: string}) => {
  const id = language.id;
  return id === 'en' || id === 'zh' ? value[id] : textIn(value.en, id);
};
const permalink = new URL(Astro.url.pathname, Astro.site).href;
const schema = post.slug === 'understanding-ppf-layers' ? [{
  '@type': 'Article', '@id': permalink + '#article', mainEntityOfPage: permalink,
  headline: articleText(post.title), description: articleText(post.excerpt), inLanguage: language.tag,
  image: new URL('/images/' + post.image, Astro.site).href,
  publisher: {'@id': new URL('/#organization', Astro.site).href},
}] : [];
---
<Layout title={post.title[lang]} description={post.excerpt[lang]} schema={schema}>
 <article class="journal-article"><header class="container article-heading"><a class="text-link" href={path('/blog/')}>← {z?'返回博客':'Back to journal'}</a>
 <div class="journal-meta"><span>{post.category[lang]}</span>{original?.date&&<time datetime={original.date}>{original.date}</time>}<span>{post.readMinutes} {z?'分钟阅读':'MIN READ'}</span></div><h1>{post.title[lang]}</h1><p>{post.excerpt[lang]}</p></header>
 <figure class="article-cover container"><img src={'/images/'+post.image} width="1400" height="760" alt={post.title[lang]}/></figure>
 <div class="article-body">{post.sections.map(s=><section><h2>{s.heading[lang]}</h2><p>{s.body[lang]}</p></section>)}
 {original&&(z?<>{original.zhSections.map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>)}<details class="library-fold"><summary>阅读完整英文原文</summary><div lang="en"><SourceText html={original.body}/></div></details></>:<SourceText html={original.body}/>)}
 {product&&<aside class="article-sources"><h2>{z?'文中相关产品':'Featured product'}</h2><a class="text-link" href={path('/products/'+product.slug+'/')}>{product.name} ↗</a></aside>}
 {!!post.sources.length&&<aside class="article-sources"><h2>{z?'参考资料':'References'}</h2><p>{z?'具体产品参数与养护要求，请以所选云辇型号的资料为准。':'Use the selected YUNNIAN model’s documentation for its specifications and care requirements.'}</p><ul>{post.sources.filter(s=>!new URL(s.url).hostname.endsWith('1688.com')).map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a></li>)}</ul></aside>}
 <div class="article-next">{clearFilmGuide && <a class="text-link" href={path(tpuPagePath)}>{copy.compareLink}</a>}<a class="button button-dark" href={path('/film-lab/')}>{z?'进入 3D 材料工作室':'Explore the 3D material studio'} ↗</a><a class="text-link" href={path('/products/')}>{z?'浏览产品':'Explore the collection'} ↗</a></div></div></article>
</Layout>
